# Example values for running the application on the host (`go run ./cmd/api`)
# against the dependencies started by `docker compose up postgres migrate localstack keycloak`.
# Local development values only; no real secrets.

INSTANCE_ID=local
HTTP_ADDR=:8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=30s

DATABASE_URL=postgres://wagering_app:app_local_pw@localhost:5432/wagering?sslmode=disable
DATABASE_MAX_CONNS=10

AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

SQS_INPUT_QUEUE=wager-transactions.fifo
SQS_EVENTS_QUEUE=wager-events.fifo
SQS_DEAD_LETTER_QUEUE=wager-transactions-dlq.fifo
SQS_CONSUMER_WORKERS=4
SQS_CONSUMER_BATCH_SIZE=10
SQS_CONSUMER_POLL_WAIT=20s
SQS_CONSUMER_PROCESSING_TIMEOUT=20s
SQS_CONSUMER_RETRY_BACKOFF_BASE=2s
SQS_CONSUMER_RETRY_BACKOFF_MAX=60s

OIDC_ISSUER_URL=http://localhost:8180/realms/wagering
OIDC_DISCOVERY_URL=http://localhost:8180/realms/wagering
OIDC_AUDIENCE=wallet-api

# Browser origins allowed to call the API (the Swagger UI in Compose). Comma separated,
# scheme://host[:port]; empty allows none.
CORS_ALLOWED_ORIGINS=http://localhost:8089

# Outbox publisher: wait when idle, events per batch (SQS allows at most 10), and how long
# a reserved event stays reserved if its publisher dies.
OUTBOX_POLL_INTERVAL=500ms
OUTBOX_BATCH_SIZE=10
OUTBOX_LEASE=30s
